    "nutrition_guideline": {
      "calories": {
        "target": "依體重與個人狀況設計，一般為 1500-2000 kcal/day",
        "note": "晚期 CKD（stage 4-5）需特別重視熱量攝取以維持營養。"
      },
      "sodium": {
        "target": "限制攝取，避免高鹽，通常建議每日鈉攝取 < 2000 mg（約5g鹽）",
        "note": "過多鹽分會導致高血壓、水腫；應減少鹽與醬油的使用量，避免高鹽食品及湯品。"
      },
      "protein": {
        "target": "Stage 1-3: 0.8-1.0 g/kg/day，不超過1.5g/kg/day；Stage 4: 0.6 g/kg/day（若合併糖尿病，0.8g/kg/day）",
        "note": "蛋白質攝取依分期明顯不同，詳細須遵營養師指示。初期不需嚴格限制，中～晚期需逐步減量。"
      },
      "fat": {
        "total_fat": "適量，選擇植物油和不飽和脂肪為主，減少飽和脂肪與反式脂肪",
        "saturated_fat": "盡量減少（避免肥肉、油炸、奶油等）",
        "trans_fat": "避免",
        "cholesterol": "",
        "note": "高脂血患者總膽固醇<200mg/dl，三酸甘油脂<150mg/dl，HDL男性≧55、女性≧60mg/dl，LDL<100mg/dl。"
      },
      "sugar": {
        "target": "",
        "note": "糖尿病合併者血糖控制標準: 餐前血糖90-130mg/dl，HbA1c<7%。"
      },
      "fiber": {
        "soluble_fiber": "",
        "total_fiber": "",
        "note": "蔬菜攝取3-4份/日，水果2-3份/日，根據血鉀狀態適度調整。"
      }
