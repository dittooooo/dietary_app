    <edge source="&quot;FAMILY&quot;" target="&quot;GAMES&quot;">
      <data key="d3">1.0</data>
      <data key="d4">"Family members engage in traditional Christmas games like blind man's buff and forfeits, fostering joy and togetherness."|</data>
      <data key="d5">adad8724255cb219e0e4760c3773404c</data>
    </edge>
    <edge source="&quot;LIGHTHOUSE&quot;" target="&quot;SEA&quot;">
      <data key="d3">1.0</data>
      <data key="d4">"The lighthouse is situated on a reef in the sea, serving as a beacon of guidance amidst the dangerous waters."</data>
      <data key="d5">25293d3af56b1e8bb7387f18e5f830c6</data>
    </edge>
    <edge source="&quot;SHIP&quot;" target="&quot;SEA&quot;">
      <data key="d3">1.0</data>
      <data key="d4">"The ship is built upon a reef in the sea, illustrating the perilous environment and the setting for the seafarers' Christmas celebration."</data>
      <data key="d5">25293d3af56b1e8bb7387f18e5f830c6</data>
    </edge>
    <edge source="&quot;SCROOGE'S NIECE&quot;" target="&quot;THE LADIES&quot;">
      <data key="d3">1.0</data>
      <data key="d4">"The Ladies are the family members and friends who gather for Christmas, engaging in social activities and expressing opinions about wealth and happiness."|</data>
      <data key="d5">eaa11e11b4e9c6586b9128388a9fe4ea</data>
    </edge>
    <edge source="&quot;OLD SCRATCH&quot;" target="&quot;CONVERSATION&quot;">
      <data key="d3">1.0</data>
      <data key="d4">"Old Scratch is referenced in a colloquial conversation, symbolizing evil or temptation."</data>
      <data key="d5">2f4b2f4053b5911c93f7f63677f780fe</data>
    </edge>
    <edge source="&quot;THE SHOP&quot;" target="&quot;OLD JOE&quot;">
      <data key="d3">1.0</data>
      <data key="d4">"Old Joe is a character within the shop, involved in illicit dealings, symbolizing crime."</data>
      <data key="d5">2f4b2f4053b5911c93f7f63677f780fe</data>
    </edge>
    <edge source="&quot;OLD JOE&quot;" target="&quot;THE WOMAN WITH HEAVY BUNDLE&quot;">
      <data key="d3">1.0</data>
      <data key="d4">"Old Joe interacts with or recognizes the woman, indicating social connections or transactions."</data>
      <data key="d5">2f4b2f4053b5911c93f7f63677f780fe</data>
    </edge>
    <edge source="&quot;OLD JOE&quot;" target="&quot;THE LAUNDRESS&quot;">
      <data key="d3">1.0</data>
      <data key="d4">"Old Joe interacts with or recognizes the laundress, indicating social or economic ties."</data>
      <data key="d5">2f4b2f4053b5911c93f7f63677f780fe</data>
    </edge>
    <edge source="&quot;OLD JOE&quot;" target="&quot;THE UNDERTAKER'S MAN&quot;">
      <data key="d3">1.0</data>
      <data key="d4">"Old Joe" and the undertaker's man are part of the same scene, involved in a shared context of crime and death."</data>
      <data key="d5">2f4b2f4053b5911c93f7f63677f780fe</data>
    </edge>
    <edge source="&quot;OLD JOE&quot;" target="&quot;SHOP&quot;">
      <data key="d3">1.0</data>
      <data key="d4">"Old Joe is the proprietor or worker at the shop, managing the space and conducting the valuation of items."|</data>
      <data key="d5">13bc5cc4ab04eb9c1378f28106aecc55</data>
    </edge>
    <edge source="&quot;MRS. DILBER&quot;" target="&quot;SHOP&quot;">
      <data key="d3">1.0</data>
      <data key="d4">"Mrs. Dilber works at the shop, involved in the theft and valuation of items."|</data>
      <data key="d5">13bc5cc4ab04eb9c1378f28106aecc55</data>
    </edge>
    <edge source="&quot;THE WOMAN&quot;" target="&quot;SHOP&quot;">
      <data key="d3">1.0</data>
      <data key="d4">"The Woman is present at the shop, participating in the theft and discussing her actions."|</data>
      <data key="d5">13bc5cc4ab04eb9c1378f28106aecc55</data>
    </edge>
    <edge source="&quot;MOTHER AND CHILDREN&quot;" target="&quot;HUSBAND&quot;">
      <data key="d3">1.0</data>
      <data key="d4">"The husband is part of the family unit, and his death impacts the mother and children, illustrating familial bonds affected by mortality."</data>
      <data key="d5">f12da31d40e34efbe8c2c848cff576db</data>
    </edge>
    <edge source="&quot;CAROLINE&quot;" target="&quot;HE&quot;">
      <data key="d3">1.0</data>
      <data key="d4">"He is the person Caroline is speaking to about their situation, indicating a close relationship and shared concern."|</data>
      <data key="d5">696cd4a0ae22e395f3c9d04cfcea8d49</data>
    </edge>
    <edge source="&quot;STREET DOOR&quot;" target="&quot;KNOCKER&quot;">
      <data key="d3">1.0</data>
      <data key="d4">"The street door's knocker is a notable object that catches Scrooge's eye, symbolizing reflection and supernatural influence."</data>
      <data key="d5">4d24514bfd653ec63181d9d824eb98ef</data>
    </edge>
    <edge source="&quot;THE FOUNDATION&quot;" target="&quot;PROJECT GUTENBERG&quot;">
