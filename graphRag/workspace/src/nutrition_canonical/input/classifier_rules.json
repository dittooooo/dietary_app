{
  "version": "1.0.0",
  "description": "Rule set for classifying nutrition items into canonical ingredients, subtypes, derived products, and excluded default results.",
  "text_normalization": {
    "trim_whitespace": true,
    "normalize_fullwidth_halfwidth": true,
    "normalize_parentheses": true,
    "lowercase_english": true,
    "split_alias_delimiters": [
      ",",
      "，",
      "/",
      "、",
      ";",
      "；"
    ],
    "remove_duplicate_aliases": true,
    "collapse_spaces": true,
    "character_replacements": {
      "蕃茄": "番茄",
      "裏肌": "里肌",
      "台": "臺"
    },
    "strip_prefix_tokens": [
      "新鮮",
      "冷凍",
      "冷藏",
      "市售",
      "國產",
      "進口",
      "本產",
      "現成",
      "即食"
    ]
  },
  "priority_order": [
    "hard_exclusion_patterns",
    "brand_detection",
    "flavor_detection",
    "derived_product_detection",
    "processing_detection",
    "subtype_detection",
    "canonical_alias_resolution",
    "fallback_keyword_resolution"
  ],
  "hard_exclusion_patterns": {
    "contains_any": [
      "套餐",
      "便當",
      "披薩",
      "濃湯",
      "湯底",
      "火鍋料組",
      "料理包",
      "調理包"
    ],
    "assign": {
      "match_type": "mixed_food",
      "entity_role": "mixed_item",
      "is_base_food": false,
      "is_query_default": false,
      "is_search_hidden_by_default": true,
      "search_priority": 0,
      "exclude_reasons": [
        "mixed_or_ready_meal"
      ]
    }
  },
  "brand_detection": {
    "brand_keywords": [
      "金蘭",
      "統一",
      "味全",
      "義美",
      "光泉",
      "林鳳營",
      "福樂",
      "好市多",
      "全聯",
      "7-11",
      "統一超",
      "家樂福",
      "愛之味"
    ],
    "assign": {
      "match_type": "brand_or_commercial_item",
      "entity_role": "commercial_product"
    },
    "default_visibility": {
      "is_query_default": false,
      "is_search_hidden_by_default": true,
      "search_priority_penalty": 40
    }
  },
  "flavor_detection": {
    "flavor_keywords": [
      "巧克力",
      "草莓",
      "布丁",
      "香草",
      "抹茶",
      "咖啡",
      "可可",
      "香蕉",
      "果汁",
      "麥芽",
      "蜂蜜",
      "焦糖"
    ],
    "assign": {
      "entity_role": "beverage"
    },
    "default_visibility": {
      "is_query_default": false,
      "is_search_hidden_by_default": true,
      "search_priority_penalty": 50
    }
  },
  "processing_detection": {
    "processing_keywords": {
      "fresh": [
        "鮮",
        "現採",
        "新鮮"
      ],
      "dried": [
        "乾",
        "脫水"
      ],
      "frozen": [
        "冷凍"
      ],
      "powder": [
        "粉"
      ],
      "paste": [
        "糊",
        "泥",
        "醬泥"
      ],
      "sauce": [
        "醬",
        "膏",
        "露",
        "汁"
      ],
      "canned": [
        "罐頭",
        "罐"
      ],
      "pickled": [
        "醃",
        "泡菜",
        "漬"
      ],
      "fermented": [
        "發酵",
        "味噌",
        "豆豉",
        "乳酸"
      ],
      "fried": [
        "油炸",
        "炸"
      ],
      "baked": [
        "烘焙",
        "烤"
      ],
      "boiled": [
        "水煮",
        "熟"
      ],
      "roasted": [
        "烘烤",
        "焙炒"
      ],
      "instant": [
        "即溶",
        "速食",
        "泡麵"
      ],
      "ready_to_eat": [
        "即食",
        "熟食"
      ],
      "sterilized": [
        "滅菌"
      ],
      "ultra_heat_treated": [
        "保久乳"
      ]
    }
  },
  "state_and_subtype_keywords": {
    "fat_level": {
      "全脂": "全脂",
      "高脂": "高脂",
      "中脂": "中脂",
      "低脂": "低脂",
      "脫脂": "脫脂"
    },
    "flour_strength": {
      "低筋": "低筋",
      "中筋": "中筋",
      "高筋": "高筋"
    },
    "tofu_texture": {
      "嫩豆腐": "嫩豆腐",
      "板豆腐": "板豆腐",
      "雞蛋豆腐": "雞蛋豆腐",
      "凍豆腐": "凍豆腐",
      "百頁豆腐": "百頁豆腐",
      "豆干": "豆干"
    },
    "cut_or_part": {
      "去皮": "去皮",
      "帶皮": "帶皮",
      "去骨": "去骨",
      "帶骨": "帶骨",
      "里肌": "里肌",
      "五花": "五花",
      "腿": "腿",
      "胸": "胸",
      "翅": "翅"
    },
    "generic_state": {
      "生": "生",
      "熟": "熟",
      "無鹽": "無鹽",
      "有鹽": "有鹽",
      "原味": "原味"
    }
  },
  "derived_product_detection": {
    "contains_any": [
      "醬",
      "膏",
      "糊",
      "汁",
      "罐頭",
      "濃縮",
      "飲",
      "乳飲",
      "調味乳",
      "抹醬",
      "湯塊",
      "高湯"
    ],
    "exceptions_allow_base": [
      "味噌",
      "豆腐",
      "豆干",
      "保久乳",
      "鮮乳",
      "優格",
      "優酪乳"
    ],
    "assign": {
      "match_type": "derived_product",
      "entity_role": "derived_food",
      "is_query_default": false,
      "is_search_hidden_by_default": true,
      "search_priority_penalty": 35
    }
  },
  "seasoning_detection": {
    "canonical_groups": {
      "鹽": "調味料",
      "糖": "調味料",
      "醬油": "調味料",
      "醬油膏": "調味料",
      "蠔油": "調味料",
      "蠔油膏": "調味料",
      "味噌": "調味料",
      "胡椒粉": "調味料",
      "花椒粉": "調味料",
      "辣椒醬": "調味料",
      "番茄醬": "調味料"
    }
  },
  "canonical_alias_map": {
    "牛奶": [
      "牛乳",
      "鮮奶",
      "鮮乳",
      "milk"
    ],
    "番茄": [
      "蕃茄",
      "西紅柿"
    ],
    "蒜頭": [
      "蒜",
      "大蒜",
      "蒜末",
      "蒜蓉"
    ],
    "青蔥": [
      "蔥",
      "蔥花",
      "青蔥"
    ],
    "洋蔥": [
      "白洋蔥",
      "黃洋蔥",
      "紫洋蔥",
      "紫色洋蔥"
    ],
    "醬油": [
      "醬油露"
    ],
    "白胡椒粉": [
      "白胡椒"
    ],
    "黑胡椒粉": [
      "黑胡椒"
    ],
    "麵粉": [
      "麵粉類"
    ],
    "雞蛋": [
      "蛋",
      "雞蛋",
      "蛋液"
    ],
    "豆腐": [
      "板豆腐",
      "嫩豆腐",
      "凍豆腐"
    ],
    "油": [
      "植物油",
      "食用油",
      "沙拉油",
      "烹調油"
    ]
  },
  "canonical_resolution_rules": [
    {
      "canonical_name": "牛奶",
      "when_contains_any": [
        "牛奶",
        "牛乳",
        "鮮乳",
        "鮮奶",
        "保久乳"
      ],
      "exclude_if_contains_any": [
        "羊",
        "巧克力",
        "草莓",
        "布丁",
        "果汁",
        "調味"
      ],
      "canonical_group": "乳品",
      "default_subtypes": [
        "全脂鮮乳",
        "低脂鮮乳",
        "脫脂鮮乳",
        "中脂保久乳",
        "全脂保久乳"
      ],
      "hide_subtypes": [
        "調味乳",
        "乳飲品"
      ],
      "default_priority": 90
    },
    {
      "canonical_name": "番茄",
      "when_contains_any": [
        "番茄"
      ],
      "exclude_if_contains_any": [
        "醬",
        "糊",
        "汁"
      ],
      "canonical_group": "蔬菜",
      "default_subtypes": [
        "番茄",
        "小番茄",
        "牛番茄"
      ],
      "hide_subtypes": [
        "番茄醬",
        "番茄糊",
        "番茄汁"
      ],
      "default_priority": 88
    },
    {
      "canonical_name": "蒜頭",
      "when_contains_any": [
        "蒜"
      ],
      "exclude_if_contains_any": [
        "蒜醬",
        "蒜粉調味"
      ],
      "canonical_group": "辛香料",
      "default_subtypes": [
        "蒜頭"
      ],
      "default_priority": 85
    },
    {
      "canonical_name": "洋蔥",
      "when_contains_any": [
        "洋蔥"
      ],
      "canonical_group": "蔬菜",
      "default_subtypes": [
        "洋蔥",
        "紫色洋蔥"
      ],
      "default_priority": 86
    },
    {
      "canonical_name": "麵粉",
      "when_contains_any": [
        "麵粉"
      ],
      "canonical_group": "穀物雜糧",
      "default_subtypes": [
        "低筋麵粉",
        "中筋麵粉",
        "高筋麵粉"
      ],
      "default_priority": 87
    },
    {
      "canonical_name": "豆腐",
      "when_contains_any": [
        "豆腐"
      ],
      "exclude_if_contains_any": [
        "豆腐醬"
      ],
      "canonical_group": "豆類豆製品",
      "default_subtypes": [
        "板豆腐",
        "嫩豆腐",
        "凍豆腐"
      ],
      "hide_subtypes": [
        "百頁豆腐",
        "雞蛋豆腐"
      ],
      "default_priority": 89
    },
    {
      "canonical_name": "醬油",
      "when_contains_any": [
        "醬油"
      ],
      "canonical_group": "調味料",
      "default_subtypes": [
        "醬油",
        "薄鹽醬油",
        "無添加醬油"
      ],
      "hide_subtypes": [
        "醬油膏"
      ],
      "default_priority": 84
    },
    {
      "canonical_name": "油",
      "when_contains_any": [
        "油"
      ],
      "canonical_group": "油脂",
      "exclude_if_contains_any": [
        "油蔥酥",
        "辣油醬"
      ],
      "default_subtypes": [
        "植物油",
        "橄欖油",
        "芥花油",
        "大豆油"
      ],
      "default_priority": 83
    }
  ],
  "group_assignment_by_category": {
    "乳品類": "乳品",
    "蛋類": "蛋類",
    "豆類": "豆類豆製品",
    "豆製品": "豆類豆製品",
    "蔬菜類": "蔬菜",
    "水果類": "水果",
    "堅果及種子類": "堅果種子",
    "油脂類": "油脂",
    "穀物類": "穀物雜糧",
    "肉類": "肉類",
    "魚貝類": "海鮮水產",
    "調味料及香辛料類": "調味料"
  },
  "query_default_rules": {
    "exact_base_food": 95,
    "alias_of_base_food": 92,
    "subtype_of_base_food": 88,
    "state_variant": 78,
    "part_variant": 76,
    "processing_variant": 72,
    "derived_product": 30,
    "seasoning_or_sauce": 40,
    "beverage_variant": 20,
    "brand_or_commercial_item": 10,
    "mixed_food": 0,
    "uncertain": 5
  },
  "classification_postprocessing": {
    "if_brand_and_flavored_then_hide": true,
    "if_derived_product_then_not_default": true,
    "if_mixed_food_then_not_base_food": true,
    "if_name_contains_parenthetical_flavor_then_add_flavor_tag": true,
    "if_canonical_name_missing_then_set_uncertain": true
  },
  "examples": [
    {
      "raw_name": "中脂調味保久乳(布丁)",
      "canonical_name": "牛奶",
      "match_type": "beverage_variant",
      "entity_role": "beverage",
      "is_base_food": false,
      "is_query_default": false,
      "exclude_reasons": [
        "flavored_milk",
        "not_plain_milk"
      ]
    },
    {
      "raw_name": "中脂保久乳",
      "canonical_name": "牛奶",
      "match_type": "processing_variant",
      "entity_role": "subtype",
      "is_base_food": true,
      "is_query_default": true
    },
    {
      "raw_name": "番茄糊",
      "canonical_name": "番茄",
      "match_type": "derived_product",
      "entity_role": "derived_food",
      "is_base_food": false,
      "is_query_default": false
    },
    {
      "raw_name": "金蘭無添加醬油",
      "canonical_name": "醬油",
      "match_type": "brand_or_commercial_item",
      "entity_role": "commercial_product",
      "is_base_food": false,
      "is_query_default": false
    },
    {
      "raw_name": "低筋麵粉",
      "canonical_name": "麵粉",
      "match_type": "subtype_of_base_food",
      "entity_role": "subtype",
      "is_base_food": true,
      "is_query_default": true
    }
  ]
}