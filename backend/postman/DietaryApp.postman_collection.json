  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('register status is 200 or existing account is 400', function () {",
                  "  pm.expect([200, 400]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.test('register success response has token', function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.needsOnboarding).to.eql(true);",
                  "  });",
                  "  pm.collectionVariables.set('userToken', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user001@gmail.com\",\n  \"password\": \"User123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('login status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const token = pm.response.text().replace(/^\\\"|\\\"$/g, '');",
                  "pm.test('login returns token text', function () {",
                  "  pm.expect(token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('userToken', token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user001@gmail.com\",\n  \"password\": \"User123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          }
        },
